#: src/lanterna/__main__.py:28
#, python-brace-format
msgid "usage: {command} [FOLDER...]"
msgstr "uso: {command} [CARTELLA...]"

#: src/lanterna/app.py:35
#, python-brace-format
msgid ""
"The settings file was damaged: the previous save was used. The damaged file "
"is kept at {path}."
msgstr ""
"Il file delle impostazioni era danneggiato: è stato usato il salvataggio "
"precedente. Il file danneggiato è conservato in {path}."

#: src/lanterna/app.py:38
#, python-brace-format
msgid ""
"The settings file was damaged and there was no previous save: the app starts "
"with its defaults. The damaged file is kept at {path}."
msgstr ""
"Il file delle impostazioni era danneggiato e non c'era un salvataggio "
"precedente: l'app parte con le impostazioni predefinite. Il file danneggiato "
"è conservato in {path}."

#: src/lanterna/app.py:41
msgid "The settings file was missing: the previous save was used."
msgstr ""
"Il file delle impostazioni mancava: è stato usato il salvataggio precedente."

#: src/lanterna/app.py:43
#, python-brace-format
msgid ""
"The settings were saved by a newer version ({version}): what this version "
"does not know is kept untouched."
msgstr ""
"Le impostazioni sono state salvate da una versione più recente ({version}): "
"ciò che questa versione non conosce resta com'è."

#: src/lanterna/app.py:218
#, python-brace-format
msgid "The settings could not be saved: {error}"
msgstr "Impossibile salvare le impostazioni: {error}"

#: src/lanterna/app.py:264
#, python-brace-format
msgid "The check for updates failed: {error}"
msgstr "Il controllo degli aggiornamenti non è riuscito: {error}"

#: src/lanterna/app.py:268
#, python-brace-format
msgid "{app} {version} is up to date"
msgstr "{app} {version} è aggiornata"

#: src/lanterna/app.py:273 src/lanterna/update_dialog.py:32
#, python-brace-format
msgid "{app} {version} is available"
msgstr "È disponibile {app} {version}"

#: src/lanterna/app.py:274
msgid "Click to see what is new and update."
msgstr "Fai clic per vedere le novità e aggiornare."

#: src/lanterna/media.py:134
msgid "The TV does not show this kind of image"
msgstr "La TV non mostra questo tipo di immagine"

#: src/lanterna/media.py:143
msgid "The TV does not play this sound format"
msgstr "La TV non riproduce questo formato audio"

#: src/lanterna/media.py:144
msgid "Nothing to show in this file"
msgstr "In questo file non c'è niente da mostrare"

#: src/lanterna/media.py:158
msgid "The TV does not play this film's sound, so the sound is converted"
msgstr ""
"La TV non riproduce l'audio di questo film, quindi l'audio viene convertito"

#: src/lanterna/media.py:162
msgid "The TV does not open this kind of file, so the film is repacked"
msgstr ""
"La TV non apre questo tipo di file, quindi il film viene reimpacchettato"

#: src/lanterna/media.py:165
msgid "The TV does not play this kind of video, so the film is converted"
msgstr ""
"La TV non riproduce questo tipo di video, quindi il film viene convertito"

#: src/lanterna/screencast.py:123
#, python-brace-format
msgid "The screen cannot be shared here: {error}"
msgstr "Lo schermo non si può condividere qui: {error}"

#: src/lanterna/screencast.py:180
msgid "The system refused to share the screen"
msgstr "Il sistema ha rifiutato di condividere lo schermo"

#: src/lanterna/screencast.py:197
msgid "The system shared nothing"
msgstr "Il sistema non ha condiviso niente"

#: src/lanterna/screencast.py:328
msgid "No H.264 encoder is installed"
msgstr "Non è installato nessun codificatore H.264"

#: src/lanterna/screencast.py:349 src/lanterna/screencast.py:357
msgid "The screen cannot be converted"
msgstr "Impossibile convertire lo schermo"

#: src/lanterna/screencast.py:364
msgid "The screen stopped arriving"
msgstr "Lo schermo ha smesso di arrivare"

#: src/lanterna/screencast.py:388
msgid "A Window"
msgstr "Una finestra"

#: src/lanterna/screencast.py:388
msgid "The Screen"
msgstr "Lo schermo"

#: src/lanterna/session.py:153
msgid "Nothing to show"
msgstr "Niente da mostrare"

#: src/lanterna/session.py:216 src/lanterna/window.py:318
#, python-brace-format
msgid "{name} cannot be read: {error}"
msgstr "Impossibile leggere {name}: {error}"

#: src/lanterna/session.py:233
#, python-brace-format
msgid "The TV refused this file ({reasons})"
msgstr "La TV ha rifiutato questo file ({reasons})"

#: src/lanterna/session.py:242
#, python-brace-format
msgid ""
"Port {port} cannot be used ({reason}). Another program may have it: choose "
"another one in Preferences, or turn the fixed port off."
msgstr "Porta {port} non utilizzabile ({reason}). Forse la usa un altro programma: sceglierne un'altra nelle Preferenze, oppure spegnere la porta fissa."

#: src/lanterna/session.py:259
#, python-brace-format
msgid "{tv} does not answer: {error}"
msgstr "{tv} non risponde: {error}"

#: src/lanterna/session.py:304
msgid "The connection to the TV is gone"
msgstr "La connessione con la TV si è interrotta"

#: src/lanterna/session.py:324
msgid "The TV did not start playing"
msgstr "La TV non ha avviato la riproduzione"

#: src/lanterna/session.py:340
#, python-brace-format
msgid "The stream stopped: {error}"
msgstr "Il flusso si è interrotto: {error}"

#: src/lanterna/session.py:384 src/lanterna/session.py:455
msgid "Nothing is playing"
msgstr "Non c'è niente in riproduzione"

#: src/lanterna/session.py:386
msgid "The screen has no other point to go to"
msgstr "Lo schermo non ha un altro punto a cui andare"

#: src/lanterna/session.py:474
msgid "The TV could not play it this way"
msgstr "La TV non è riuscita a riprodurlo in questo modo"

#: src/lanterna/session.py:490
msgid "The TV stopped playing"
msgstr "La TV ha interrotto la riproduzione"

#: src/lanterna/session.py:521
#, python-brace-format
msgid "Lost the connection to {tv}: {reason}"
msgstr "Connessione con {tv} persa: {reason}"

#: src/lanterna/update_dialog.py:22
msgid "Update Available"
msgstr "Aggiornamento disponibile"

#: src/lanterna/update_dialog.py:35
#, python-brace-format
msgid "You are using version {version}."
msgstr "Stai usando la versione {version}."

#: src/lanterna/update_dialog.py:50
msgid "Later"
msgstr "Più tardi"

#: src/lanterna/update_dialog.py:54
msgid "Download and Install"
msgstr "Scarica e installa"

#: src/lanterna/update_dialog.py:56
#, python-brace-format
msgid "{app} closes while the new version is installed, and opens again."
msgstr ""
"{app} si chiude mentre la nuova versione viene installata, e si riapre."

#: src/lanterna/update_dialog.py:59
msgid "Open the Release Page"
msgstr "Apri la pagina della versione"

#: src/lanterna/update_dialog.py:78
msgid "Downloading…"
msgstr "Scaricamento…"

#: src/lanterna/update_dialog.py:88
#, python-brace-format
msgid "Download failed: {error}"
msgstr "Scaricamento non riuscito: {error}"

#: src/lanterna/update_dialog.py:113
msgid "Starting the installer…"
msgstr "Avvio dell'installer…"

#: src/lanterna/update_dialog.py:122
#, python-brace-format
msgid "Cannot start the installer: {error}"
msgstr "Impossibile avviare l'installer: {error}"

#: src/lanterna/updates.py:126 src/lanterna/updates.py:148
msgid "unexpected answer from GitHub"
msgstr "risposta inattesa da GitHub"

#: src/lanterna/updates.py:151
#, python-brace-format
msgid "GitHub answered {code}"
msgstr "GitHub ha risposto {code}"

#: src/lanterna/updates.py:231
msgid "the release gives no checksum for the installer: not downloaded"
msgstr ""
"la versione pubblicata non indica il checksum dell'installer: non scaricato"

#: src/lanterna/updates.py:233
msgid "the release gives no signature for the installer: not downloaded"
msgstr ""
"la versione pubblicata non indica la firma dell'installer: non scaricato"

#: src/lanterna/updates.py:245
msgid "cancelled"
msgstr "annullato"

#: src/lanterna/updates.py:250 src/lanterna/updates.py:259
msgid "the file downloaded does not match the release: not started"
msgstr ""
"il file scaricato non corrisponde alla versione pubblicata: non avviato"

#: src/lanterna/updates.py:267
msgid "the installer is not signed by the project: not started"
msgstr "l'installer non è firmato dal progetto: non avviato"

#: src/lanterna/updates.py:272
#, python-brace-format
msgid "download failed ({code})"
msgstr "scaricamento non riuscito ({code})"

#: src/lanterna/window.py:86
msgid "Look Again"
msgstr "Cerca di nuovo"

#: src/lanterna/window.py:115
msgid "The TV to show things on"
msgstr "La TV su cui mostrare"

#: src/lanterna/window.py:118
msgid "Look for TVs Again"
msgstr "Cerca di nuovo le TV"

#: src/lanterna/window.py:124
msgid "Check for Updates…"
msgstr "Controlla aggiornamenti…"

#: src/lanterna/window.py:125 src/lanterna/window.py:673
msgid "Preferences"
msgstr "Preferenze"

#: src/lanterna/window.py:126
#, python-brace-format
msgid "About {app}"
msgstr "Informazioni su {app}"

#: src/lanterna/window.py:129
msgid "Main Menu"
msgstr "Menu principale"

#: src/lanterna/window.py:139
msgid "Show It on the TV"
msgstr "Mostralo sulla TV"

#: src/lanterna/window.py:140
msgid "Choose photos, a video or a film, or drop them here."
msgstr "Scegli foto, un video o un film, oppure trascinali qui."

#: src/lanterna/window.py:142
msgid "Choose Files…"
msgstr "Scegli i file…"

#: src/lanterna/window.py:145
msgid "Choose a Folder…"
msgstr "Scegli una cartella…"

#: src/lanterna/window.py:148
msgid "Show the Screen…"
msgstr "Mostra lo schermo…"

#: src/lanterna/window.py:170
msgid "Go to another point of the film"
msgstr "Vai a un altro punto del film"

#: src/lanterna/window.py:182
msgid "Previous"
msgstr "Precedente"

#: src/lanterna/window.py:186 src/lanterna/window.py:430
msgid "Pause"
msgstr "Pausa"

#: src/lanterna/window.py:190
msgid "Next"
msgstr "Successivo"

#: src/lanterna/window.py:196
msgid "The TV's Volume"
msgstr "Volume della TV"

#: src/lanterna/window.py:202
msgid "Stop"
msgstr "Ferma"

#: src/lanterna/window.py:228
msgid "No TV found. Is it on, and on this network?"
msgstr "Nessuna TV trovata. È accesa e su questa rete?"

#: src/lanterna/window.py:233
#, python-brace-format
msgid "TVs cannot be looked for: {reason}"
msgstr "Impossibile cercare le TV: {reason}"

#: src/lanterna/window.py:247
msgid "Looking for TVs…"
msgstr "Ricerca delle TV…"

#: src/lanterna/window.py:272
msgid "Photos and Videos"
msgstr "Foto e video"

#: src/lanterna/window.py:275
msgid "All Files"
msgstr "Tutti i file"

#: src/lanterna/window.py:280
msgid "Choose What to Show"
msgstr "Scegli cosa mostrare"

#: src/lanterna/window.py:292
msgid "Choose a Folder to Show"
msgstr "Scegli una cartella da mostrare"

#: src/lanterna/window.py:320
#, python-brace-format
msgid "No photos or videos in “{name}”"
msgstr "Nessuna foto o video in «{name}»"

#: src/lanterna/window.py:332
msgid "Waiting for a TV to show it on"
msgstr "In attesa di una TV su cui mostrarlo"

#: src/lanterna/window.py:361
msgid "No TV to show it on yet"
msgstr "Ancora nessuna TV su cui mostrarlo"

#: src/lanterna/window.py:371
msgid "The sharing has ended"
msgstr "La condivisione è terminata"

#: src/lanterna/window.py:386
#, python-brace-format
msgid "Something went wrong: {error}"
msgstr "Qualcosa è andato storto: {error}"

#: src/lanterna/window.py:415
msgid "Showing something on the TV"
msgstr "Qualcosa è in onda sulla TV"

#: src/lanterna/window.py:430
msgid "Play"
msgstr "Riproduci"

#: src/lanterna/window.py:459
msgid "This computer could not be silenced"
msgstr "Non è stato possibile silenziare questo computer"

#: src/lanterna/window.py:476
#, python-brace-format
msgid "Connecting to {tv}…"
msgstr "Connessione a {tv}…"

#: src/lanterna/window.py:478
#, python-brace-format
msgid "Loading on {tv}…"
msgstr "Caricamento su {tv}…"

#: src/lanterna/window.py:480
#, python-brace-format
msgid "Showing the screen on {tv}"
msgstr "Lo schermo è su {tv}"

#: src/lanterna/window.py:482
#, python-brace-format
msgid "Showing a window on {tv}"
msgstr "Una finestra è su {tv}"

#: src/lanterna/window.py:484
#, python-brace-format
msgid "On {tv}, {n} of {count}"
msgstr "Su {tv}, {n} di {count}"

#: src/lanterna/window.py:486
#, python-brace-format
msgid "Paused on {tv}"
msgstr "In pausa su {tv}"

#: src/lanterna/window.py:487
#, python-brace-format
msgid "Playing on {tv}"
msgstr "In riproduzione su {tv}"

#: src/lanterna/window.py:678
msgid "Appearance"
msgstr "Aspetto"

#: src/lanterna/window.py:679
msgid "Follow the System"
msgstr "Come il sistema"

#: src/lanterna/window.py:679
msgid "Light"
msgstr "Chiaro"

#: src/lanterna/window.py:679
msgid "Dark"
msgstr "Scuro"

#: src/lanterna/window.py:680
msgid "Theme"
msgstr "Tema"

#: src/lanterna/window.py:685
msgid "Desktop language"
msgstr "Lingua del sistema"

#: src/lanterna/window.py:686
msgid "Language"
msgstr "Lingua"

#: src/lanterna/window.py:686
msgid "Applied at the next start"
msgstr "Vale dal prossimo avvio"

#: src/lanterna/window.py:693
msgid "Showing the Screen"
msgstr "Mostrare lo schermo"

#: src/lanterna/window.py:694
msgid "Send the sound too"
msgstr "Manda anche l'audio"

#: src/lanterna/window.py:697
msgid "Keep this computer quiet meanwhile"
msgstr "Tieni in silenzio questo computer nel frattempo"

#: src/lanterna/window.py:698
msgid ""
"The TV plays the sound about three seconds later, so the two would echo. It "
"comes back when you stop."
msgstr ""
"La TV riproduce il suono circa tre secondi dopo, quindi i due farebbero eco. "
"Torna quando ti fermi."

#: src/lanterna/window.py:705
msgid "Network"
msgstr "Rete"

#: src/lanterna/window.py:706
msgid "Fixed port"
msgstr "Porta fissa"

#: src/lanterna/window.py:707
msgid ""
"For a TV on another network behind a firewall: the TV fetches what is shown "
"from this computer on this port only. Off, a free port is picked each time."
msgstr "Per una TV in un'altra rete, dietro un firewall: la TV prende ciò che è mostrato da questo computer solo su questa porta. Spenta, ogni volta si usa una porta libera."

#: src/lanterna/window.py:712
msgid "Port"
msgstr "Porta"

#: src/lanterna/window.py:722
msgid "Updates"
msgstr "Aggiornamenti"

#: src/lanterna/window.py:723
msgid "Check for updates at start-up"
msgstr "Controlla gli aggiornamenti all'avvio"

#: src/lanterna/window.py:724
msgid ""
"Once a day, from the project's releases on GitHub; nothing about you or your "
"files is sent"
msgstr ""
"Una volta al giorno, dalle versioni pubblicate su GitHub; non viene inviato "
"nulla su di te o sui tuoi file"

#: src/lanterna/window.py:753
msgid "Show photos, slides, videos and films on your TV with Chromecast."
msgstr "Mostra foto, presentazioni, video e film sulla TV con Chromecast."

#: src/lanterna/window.py:758
msgid "Measuring the space taken by the app's files…"
msgstr "Misura dello spazio occupato dai file dell'app…"
